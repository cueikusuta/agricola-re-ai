{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BGA card effect test contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "card_id": {
      "type": "string",
      "pattern": "^[A-E][0-9]{3}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "setup",
          "action",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "effect_only",
              "legal_play",
              "integration",
              "saved_replay",
              "privacy"
            ]
          },
          "setup": {
            "type": "object"
          },
          "action": {
            "type": "object"
          },
          "expected": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
