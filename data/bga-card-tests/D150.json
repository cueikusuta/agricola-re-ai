{
  "schema_version": 1,
  "card_id": "D150",
  "cases": [
    {
      "id": "D150-family-growth-2nd-person-returns-1st",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "people_placed_this_round": 1,
        "family_members": 2
      },
      "action": {
        "use_action_space": {
          "name": "family_growth",
          "person_index": 2
        }
      },
      "expected": {
        "family_members": 3,
        "people_placed_this_round": 1,
        "notes": "First person returned home, so only 1 person remains placed"
      }
    },
    {
      "id": "D150-family-growth-1st-person-no-effect",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "people_placed_this_round": 0,
        "family_members": 2
      },
      "action": {
        "use_action_space": {
          "name": "family_growth",
          "person_index": 1
        }
      },
      "expected": {
        "family_members": 3,
        "people_placed_this_round": 1
      },
      "notes": "Using Family Growth with 1st person. No return effect (needs 2nd person)."
    },
    {
      "id": "D150-other-action-no-effect",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "people_placed_this_round": 1
      },
      "action": {
        "use_action_space": {
          "name": "day_laborer"
        }
      },
      "expected": {
        "people_placed_this_round": 2
      },
      "notes": "Using Day Laborer, not Family Growth. No return effect."
    },
    {
      "id": "D150-second-family-growth-same-round",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "people_placed_this_round": 2,
        "family_members": 3
      },
      "action": {
        "use_action_space": {
          "name": "family_growth",
          "person_index": 3
        }
      },
      "expected": {
        "family_members": 4,
        "people_placed_this_round": 2,
        "notes": "Effect only triggers once per round, so 2nd Family Growth this round doesn't return another person"
      }
    }
  ]
}