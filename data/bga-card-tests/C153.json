{
  "schema_version": 1,
  "card_id": "C153",
  "cases": [
    {
      "id": "C153-normal",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "wood": 2
      },
      "action": {
        "type": "other_player_renovates",
        "owner_exchanges": true
      },
      "expected": {
        "effect_applies": true,
        "resources_exchanged": { "give": { "wood": 2 }, "receive": { "grain": 1, "food": 1, "points": 1 } }
      },
      "notes": "Other player renovates -> owner may exchange 2 wood for 1 grain + 1 food + 1 point."
    },
    {
      "id": "C153-declined",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "wood": 2
      },
      "action": {
        "type": "other_player_renovates",
        "owner_exchanges": false
      },
      "expected": {
        "effect_applies": true,
        "resources_exchanged": { "give": { "wood": 0 }, "receive": { "grain": 0, "food": 0, "points": 0 } }
      },
      "notes": "Other player renovates -> owner declines exchange."
    },
    {
      "id": "C153-insufficient-wood",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "wood": 1
      },
      "action": {
        "type": "other_player_renovates",
        "owner_exchanges": true
      },
      "expected": {
        "effect_applies": false,
        "error": "insufficient_resources"
      },
      "notes": "Owner has only 1 wood, cannot pay 2 wood -> exchange rejected."
    },
    {
      "id": "C153-owner-renovates",
      "scope": "effect_only",
      "setup": {
        "card_played": true,
        "wood": 2
      },
      "action": {
        "type": "owner_renovates"
      },
      "expected": {
        "effect_applies": false,
        "resources_exchanged": { "give": { "wood": 0 }, "receive": { "grain": 0, "food": 0, "points": 0 } }
      },
      "notes": "Owner renovates (not other player) -> effect not triggered (other_player_only condition)."
    }
  ]
}